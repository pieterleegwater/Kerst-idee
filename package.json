{
  "name": "kerstspel-op-maat",
  "version": "0.1.0",
  "private": true,
  "description": "Gepersonaliseerd kerstspel voor jouw familie of team, gemaakt in 2 minuten.",
  "type": "module",
  "main": "src/worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute kerstspel --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute kerstspel --local --file=schema.sql",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
