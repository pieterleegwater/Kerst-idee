{
  "name": "polder-liga",
  "version": "0.1.0",
  "private": true,
  "description": "Verzamel en ruil virtuele voetbalkaarten van De Polder Liga.",
  "type": "module",
  "main": "src/worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute polderliga --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute polderliga --local --file=schema.sql",
    "test": "node --no-warnings --test test/*.test.js"
  },
  "engines": { "node": ">=22.13" },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
